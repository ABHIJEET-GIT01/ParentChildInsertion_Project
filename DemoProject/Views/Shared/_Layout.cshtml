<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Professional Registration Management System" />
    <title>@ViewData["Title"] - Registration System</title>
    
    <!-- Bootstrap CSS -->
    <link href="~/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Font Awesome for Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    
    <!-- Custom Styles -->
    <link href="~/css/_layout.css" rel="stylesheet" />
</head>
<body>
    <!-- Header -->
    <header id="header">
        <div class="container">
            <h1>
                <i class="fas fa-user-check"></i> Registration Management System
            </h1>
        </div>
    </header>

    <!-- Main Content -->
    <main role="main" class="container pb-3">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 Registration System. All rights reserved.</p>
        </div>
    </footer>

    <!-- jQuery -->
    <script src="~/jquery/jquery.min.js"></script>
    
    <!-- Bootstrap JS -->
    <script src="~/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Render Sections -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
